    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const p = item.json;\n\n  // Normalise the Indian phone number\n  const digits = String(p.phone || \"\").replace(/\\D/g, \"\");\n\n  let mobile;\n\n  if (digits.length === 10) {\n    mobile = digits;\n  } else if (digits.length === 12 && digits.startsWith(\"91\")) {\n    mobile = digits.slice(2);\n  } else {\n    throw new Error(`Invalid Indian phone number for patient ${p.patient_id}`);\n  }\n\n  const phone = `+91${mobile}`;\n\n  // Personalise the message\n  const firstName = String(p.first_name || \"\").trim() || \"there\";\n  const treatment = String(p.last_treatment || \"\").trim();\n\n  let message;\n\n  if (treatment) {\n    message = `Hi ${firstName} 👋\n\nHope you're doing well! 😊 It's been a little while since your ${treatment} visit at Sample Practice.\n\nWould you like to check out some convenient appointment slots?`;\n  } else {\n    message = `Hi ${firstName} 👋\n\nHope you're doing well! 😊 It's been a little while since your last visit to Sample Practice.\n\nWould you like to check out some convenient appointment slots?`;\n  }\n\n  return {\n    json: {\n      patient_id: p.patient_id,\n      phone,\n      first_name: firstName,\n      message\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        64
      ],
      "id": "3836d037-d85a-4c5b-b747-e299d7bc8285",
      "name": "Prepare the response"
    },
