      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst webhookData = $('Webhook').first().json;\nconst body = webhookData.body || {};\n\nconst queueId = String(body.queue_id || '').trim();\nconst newStatus = String(body.status || '').trim().toUpperCase();\n\nif (!queueId || !newStatus) {\n  return [\n    {\n      json: {\n        success: false,\n        valid: false,\n        error: \"queue_id and status are required\"\n      }\n    }\n  ];\n}\n\nif (rows.length === 0) {\n  return [\n    {\n      json: {\n        success: false,\n        valid: false,\n        queue_id: queueId,\n        status: newStatus,\n        error: \"Human handoff not found\"\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      valid: true,\n      queue_id: queueId,\n      status: newStatus,\n      handoff: rows[0]\n    }\n  }\n];"
      },
