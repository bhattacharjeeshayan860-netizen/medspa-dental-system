      "id": "ed04c64d-1fce-46b9-ba11-474468bea198",
      "name": "Webhook",
      "notes": "PATCH /human-handoff-status. Accepts only OPEN or RESOLVED and matches by unique queue_id.",
      "webhookId": "924ba02e-2cbf-41ac-bde4-cdf08fd1aa6a"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\n\nconst queueId = String(body.queue_id || '').trim();\nconst status = String(body.status || '').trim().toUpperCase();\n\nif (!queueId) {\n  return [\n    {\n      json: {\n        success: false,\n        error: 'queue_id is required',\n        valid: false\n      }\n    }\n  ];\n}\n\nif (!status) {\n  return [\n    {\n      json: {\n        success: false,\n        error: 'status is required',\n        valid: false\n      }\n    }\n  ];\n}\n\nconst allowedStatuses = [\n  'OPEN',\n  'RESOLVED'\n];\n\nif (!allowedStatuses.includes(status)) {\n  return [\n    {\n      json: {\n        success: false,\n        error: 'Invalid status',\n        allowed_statuses: allowedStatuses,\n        valid: false\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      valid: true,\n      queue_id: queueId,\n      status: status\n    }\n  }\n];"
      },
