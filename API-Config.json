        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst config = {};\n\nfor (const row of rows) {\n  const key = String(row.key || \"\").trim();\n\n  if (!key) {\n    continue;\n  }\n\n  config[key] = row.value ?? \"\";\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      config\n    }\n  }\n];"
