      "parameters": {
        "jsCode": "const offers = $input.all().map(item => item.json);\n\n// Get today's date in India as YYYY-MM-DD\nconst today = new Intl.DateTimeFormat(\"en-CA\", {\n  timeZone: \"Asia/Kolkata\",\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\"\n}).format(new Date());\n\nconst validOffers = offers.filter(offer => {\n  const active =\n    String(offer.active || \"\").trim().toUpperCase() === \"YES\";\n\n  const validUntil =\n    String(offer.valid_until || \"\").trim();\n\n  // Must be active\n  if (!active) {\n    return false;\n  }\n\n  // Must have an expiry date\n  if (!validUntil) {\n    return false;\n  }\n\n  // Must not be expired\n  return validUntil >= today;\n});\n\nreturn [\n  {\n    json: {\n      success: true,\n      offers: validOffers,\n      total_offers: validOffers.length,\n      checked_on: today\n    }\n  }\n];"
      },
