      ],
      "id": "b8bb5e7b-e145-4f46-89fd-bc49ef8d012a",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const handoffs = $input.all().map(item => item.json);\n\nconst pendingHandoffs = handoffs.filter(\n  h => h.status === \"OPEN\" || h.status === \"PENDING\"\n).length;\n\nreturn [\n  {\n    json: {\n      source: \"handoffs\",\n      stats: {\n        pending_handoffs: pendingHandoffs\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        -192
      ],
      "id": "8a705d45-0f5e-4768-9b16-c694e4e0971a",
      "name": "Handoff stats"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\n\nconst dashboard = {\n  success: true,\n  stats: {\n    total_patients: 0,\n    inactive_patients: 0,\n    contacted_patients: 0,\n    active_conversations: 0,\n    pending_handoffs: 0,\n    active_offers: 0\n  }\n};\n\nfor (const item of results) {\n  const source = item.json.source;\n  const stats = item.json.stats || {};\n\n  if (source === \"patients\") {\n    dashboard.stats.total_patients = stats.total_patients || 0;\n    dashboard.stats.inactive_patients = stats.inactive_patients || 0;\n    dashboard.stats.contacted_patients = stats.contacted_patients || 0;\n  }\n\n  if (source === \"conversations\") {\n    dashboard.stats.active_conversations =\n      stats.active_conversations || 0;\n  }\n\n  if (source === \"handoffs\") {\n    dashboard.stats.pending_handoffs =\n      stats.pending_handoffs || 0;\n  }\n\n  if (source === \"offers\") {\n    dashboard.stats.active_offers =\n      stats.active_offers || 0;\n  }\n}\n\nreturn [\n  {\n    json: dashboard\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        -288
      ],
      "id": "ff9163c4-783f-430b-8798-24bf7a2861a6",
      "name": "Build Dash Response"
    }
