    {
      "parameters": {
        "jsCode": "const patients = $input.all().map(item => item.json);\n\nconst totalPatients = patients.length;\n\nconst inactivePatients = patients.filter(\n  p => Number(p.days_inactive || 0) >= 60\n).length;\n\nconst contactedPatients = patients.filter(\n  p => String(p.conversation_state || '').trim().toUpperCase() === 'CONTACTED'\n).length;\n\nreturn [\n  {\n    json: {\n      source: 'patients',\n      stats: {\n        total_patients: totalPatients,\n        inactive_patients: inactivePatients,\n        contacted_patients: contactedPatients\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        -384
      ],
      "id": "fe8b0605-cabd-49dd-8623-92960604dfd4",
      "name": "Patient stats"
    },
    {
      "parameters": {
        "jsCode": "const offers = $input.all().map(item => item.json);\n\nconst activeOffers = offers.filter(offer =>\n  String(offer.active || \"\").trim().toUpperCase() === \"YES\"\n).length;\n\nreturn [\n  {\n    json: {\n      source: \"offers\",\n      stats: {\n        active_offers: activeOffers\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        0
      ],
      "id": "fd981543-95ba-4ff2-8e4b-b03c72d75998",
      "name": "Offers stats"
    },
    {
      "parameters": {
        "jsCode": "const conversations = $input.all().map(item => item.json);\n\nconst activeConversations = conversations.filter(\n  c => c.status === \"ACTIVE\" || c.conversation_state === \"ACTIVE\"\n).length;\n\nreturn [\n  {\n    json: {\n      source: \"conversations\",\n      stats: {\n        active_conversations: activeConversations\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        -576
      ],
      "id": "1e0a96e2-6a42-4bb5-8739-0ccaa20f62b5",
      "name": "Conversation stats"
    },
    {
      "parameters": {
        "numberInputs": 4
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        688,
