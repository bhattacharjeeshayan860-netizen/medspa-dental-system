    {
      "parameters": {
        "jsCode": "const input = $('02 - Validate Input').first().json;\nconst patient = $('05 - Prepare Patient Context').first().json;\nconst historyRows = $('06 - Get Conversation History').all().map(x => x.json);\nconst offers = $('07 - Get Offers').all().map(x => x.json).filter(x => String(x.active).toUpperCase() === 'YES' || x.active === true);\nconst configRows = $('08 - Get Config').all().map(x => x.json);\nconst config = Object.fromEntries(configRows.map(x => [x.config_key || x.key, x.config_value || x.value]));\nconst human_active = Boolean(patient.human_active === true || String(patient.human_active).toUpperCase() === 'YES' || patient.conversation_state === 'HUMAN_ACTIVE');\nconst duplicate = Boolean(input.message_id && historyRows.some(x => String(x.message_id ?? '') === input.message_id));\nreturn [{\n  json: {\n    ...input,\n    ...patient,\n    duplicate,\n    human_active,\n    history: historyRows.slice(-20),\n    offers,\n    config,\n            booking_url: String(config.booking_url || '').trim()\n  }\n}];"
      },
