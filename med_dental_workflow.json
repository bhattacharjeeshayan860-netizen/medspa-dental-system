    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst rawPhone = String(body.phone ?? body.From ?? body.from ?? '').replace(/^whatsapp:/i, '').trim();\nconst phone = rawPhone.replace(/[^\\d+]/g, '').replace(/^\\+/, '');\nconst message = String(body.message ?? body.text ?? body.Body ?? body.body ?? '').trim();\nconst message_id = String(body.message_id ?? body.messageId ?? body.MessageSid ?? body.SmsMessageSid ?? '').trim();\nconst timestamp = body.timestamp ?? new Date().toISOString();\n\nconst optOutRegex = /^(stop|unsubscribe|cancel|quit|end|remove\\s*me|do\\s*not\\s*contact|dont\\s*contact|stop\\s*all)\\b/i;\nconst isOptOut = optOutRegex.test(message);\n\nreturn [{\n  json: {\n    valid: Boolean(phone && message),\n    phone,\n    message,\n    message_id,\n    timestamp,\n    is_opt_out: isOptOut\n  }\n}];"
      },
