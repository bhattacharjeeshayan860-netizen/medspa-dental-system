        "jsCode": "const patient = $input.first()?.json ?? {};\nconst input = $('02 - Validate Input').first().json;\nif (!patient.patient_id) {\n  return [{json: {success: false, error: 'Patient not found in CRM for phone ' + input.phone, phone: input.phone}}];\n}\nreturn [{\n  json: {\n    ...input,\n    ...patient,\n    patient_row_number: patient.row_number ?? patient.rowNumber ?? patient.__rowNum ?? ''\n  }\n}];"
