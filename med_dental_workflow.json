      "id": "duplicate-response",
      "name": "10A - Duplicate Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        140
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "content": "You are a warm, natural WhatsApp reactivation assistant for the practice. Use only the supplied patient, history, active offers, and config. Never invent prices, discounts, treatments, availability, policies, medical claims, or URLs. Never claim an appointment is booked. Sensitive, medical, complaint, uncertain, or staff-specific questions are HUMAN_REQUIRED. Reply like a thoughtful front-desk person who is continuing the conversation: acknowledge what the client said, answer the actual question, and ask at most one easy next question when useful. Do not use stiff phrases, internal routing labels, or generic greetings. Do not repeat the same sentence. Use the client's first name only when it feels natural. Keep replies under 60 words, use plain text, and use at most one friendly emoji only when it genuinely fits. Return JSON only: {\"intent\": \"...\", \"reply\": \"...\", \"next_state\": \"...\", \"human_reason\": \"...\"}. Allowed intents: INTERESTED, ASKING_ABOUT_OFFER, ASKING_PRICE, ASKING_ABOUT_TREATMENT, BOOKING_INTENT, NOT_INTERESTED, FOLLOW_UP_LATER, HUMAN_REQUIRED, OTHER. Allowed states: NEW, OUTREACH_SENT, WAITING_FOR_REPLY, INTERESTED, OFFER_PRESENTED, BOOKING_SENT, BOOKED, FOLLOW_UP_LATER, NOT_INTERESTED, OPTED_OUT, HUMAN_REQUIRED. BOOKING_INTENT => BOOKING_SENT and do not include the booking URL because it is added later. HUMAN_REQUIRED => HUMAN_REQUIRED. Opt-out phrases => NOT_INTERESTED."
            },
            {
              "content": "=Patient: {{$json.first_name}} {{$json.last_name}} ({{$json.patient_id}})\nCurrent state: {{$json.conversation_state}}\nActive offers: {{JSON.stringify($json.offers)}}\nTrusted config: {{JSON.stringify($json.config)}}\nRecent history: {{JSON.stringify($json.history)}}\nNewest client message: {{$json.message}}"
            }
          ]
        }
      },
      "id": "ai-engine",
      "name": "11 - AI Conversation Engine",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        2480,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('09 - Build AI Context').first().json;\n\n// Stop autonomous replies immediately if staff took over thread (human_active = true)\nif (source.human_active) {\n  return [{\n    json: {\n      ...source,\n      intent: 'HUMAN_ACTIVE',\n      next_state: 'HUMAN_ACTIVE',\n      reply: null,\n      human_reason: 'Staff takeover active (human_active = true)',\n      opt_out: source.opt_out ?? 'NO',\n      human_required: 'YES',\n      route: 'HUMAN_ACTIVE',\n      response_time_seconds: 0\n    }\n  }];\n}\n\n// Check if explicit opt-out was detected in Step 02\nif (source.is_opt_out) {\n  return [{\n    json: {\n      ...source,\n      intent: 'NOT_INTERESTED',\n      next_state: 'OPTED_OUT',\n      reply: 'Got it — I’ll stop promotional messages. You won’t hear from us again.',\n      human_reason: '',\n      opt_out: 'YES',\n      human_required: 'NO',\n      route: 'OPTOUT',\n      response_time_seconds: 0\n    }\n  }];\n}\n\nconst raw = $input.first().json.message?.content ?? $input.first().json.content ?? '{}';\nlet out;\ntry {\n  out = typeof raw === 'string' ? JSON.parse(raw.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim()) : raw;\n} catch (e) {\n  out = {};\n}\n\nconst intents = ['INTERESTED','ASKING_ABOUT_OFFER','ASKING_PRICE','ASKING_ABOUT_TREATMENT','BOOKING_INTENT','NOT_INTERESTED','FOLLOW_UP_LATER','HUMAN_REQUIRED','OTHER'];\nconst states = ['NEW','OUTREACH_SENT','WAITING_FOR_REPLY','INTERESTED','OFFER_PRESENTED','BOOKING_SENT','BOOKED','FOLLOW_UP_LATER','NOT_INTERESTED','OPTED_OUT','HUMAN_REQUIRED'];\n\nconst intent = intents.includes(out.intent) ? out.intent : 'HUMAN_REQUIRED';\nconst next_state = intent === 'BOOKING_INTENT' ? 'BOOKING_SENT' : (states.includes(out.next_state) ? out.next_state : 'HUMAN_REQUIRED');\nconst fallback = 'I want to make sure you get the right guidance, so I’m passing this to our team. Someone will get back to you shortly.';\nconst reply = typeof out.reply === 'string' && out.reply.length <= 500 ? out.reply : fallback;\nconst opt_out = (intent === 'NOT_INTERESTED' && /stop|unsubscribe|cancel|quit|end|remove\\s*me|do\\s*not\\s*contact/i.test(source.message)) ? 'YES' : (source.opt_out ?? 'NO');\nconst route = opt_out === 'YES' ? 'OPTOUT' : (intent === 'BOOKING_INTENT' ? 'BOOKING' : (intent === 'HUMAN_REQUIRED' || reply === fallback ? 'HUMAN' : (intent === 'FOLLOW_UP_LATER' ? 'FOLLOW_UP' : 'NORMAL')));\n\nreturn [{\n  json: {\n    ...source,\n    intent,\n    next_state: opt_out === 'YES' ? 'OPTED_OUT' : next_state,\n    reply: opt_out === 'YES' ? 'Got it — I’ll stop promotional messages. You won’t hear from us again.' : reply,\n    human_reason: out.human_reason ?? '',\n    opt_out,\n    human_required: route === 'HUMAN' ? 'YES' : (source.human_required ?? 'NO'),\n    route,\n    response_time_seconds: 0\n  }\n}];"
      },
