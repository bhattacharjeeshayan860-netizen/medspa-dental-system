      {"parameters":{"jsCode":"const webhook = $('API Conversations Webhook').first();\nconst query = webhook && webhook.json && webhook.json.query ? webhook.json.query : {};\nconst patientId = String(query.patient_id || '').trim();\nconst fields = ['conversation_id','patient_id','timestamp','direction','message','message_id','intent','state_before','state_after','response_time_seconds','delivery_status','campaign_id'];\nconst rows = $input.all().map(item => item.json).filter(row => {\n  if (!patientId) return Boolean(row.conversation_id || row.message);\n  return String(row.patient_id || '').trim() === patientId;\n});\nconst result = rows.map(row => {\n  const obj = {};\n  for (const field of fields) {\n    if (Object.prototype.hasOwnProperty.call(row, field)) obj[field] = row[field];\n  }\n  return obj;\n});\nreturn [{ json: { conversations: result, total_messages: result.length, patient_id: patientId || 'all' } }];"},"id":"api-conversations-transform","name":"Filter Conversations","type":"n8n-nodes-base.code","typeVersion":2,"position":[740,300]},
      {"parameters":{"respondWith":"json","responseBody":"={{ $json.conversations || [] }}","options":{}},"id":"api-conversations-response","name":"Respond Conversations","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[980,300]}
