      {"parameters":{"jsCode":"const patients = $('Get Patients').all().map(item => item.json);\nconst handoffs = $('Get Human Handoffs').all().map(item => item.json);\nconst activeStates = ['OUTREACH_SENT','WAITING_FOR_REPLY','INTERESTED','OFFER_PRESENTED','BOOKING_SENT','HUMAN_REQUIRED','FOLLOW_UP_LATER'];\nconst yes = value => String(value ?? '').trim().toUpperCase() === 'YES';\nreturn [{json: {success: true, stats: {total_clients: patients.length, eligible_clients: patients.filter(row => yes(row.reactivation_eligible)).length, active_conversations: patients.filter(row => activeStates.includes(String(row.conversation_state ?? '').trim())).length, booking_links_sent: patients.filter(row => String(row.booking_status ?? '').trim().toUpperCase() === 'BOOKING_SENT').length, booked: patients.filter(row => String(row.booking_status ?? '').trim().toUpperCase() === 'BOOKED').length, human_handoffs: handoffs.filter(row => String(row.status ?? '').trim().toUpperCase() !== 'RESOLVED').length}}}];"},"id":"api-dashboard-transform","name":"Build Dashboard JSON","type":"n8n-nodes-base.code","typeVersion":2,"position":[940,220]},
